# ─────────────────────────────────────────────────────────────────────────────
# RBLX Analytics — environment variables
# Copy to .env.local for local development. NEVER commit real secrets.
# Everything is optional: with no configuration the app runs (auto → demo
# fallback, in-memory storage).
# ─────────────────────────────────────────────────────────────────────────────

# Data source: auto | live | demo
#   auto – use Roblox's public APIs when reachable, otherwise DEMO data (labelled)
#   live – always live; errors show "Data unavailable"
#   demo – always synthetic demo data
DATA_MODE=auto

# Public URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (PostgreSQL / Supabase) ─────────────────────────────────────────
# Without it, data is kept in memory and history is lost on restart.
# Supabase: Project Settings → Database → Connection string (use the pooler URI on Vercel).
DATABASE_URL=
# Set to false for a local Postgres without TLS.
DATABASE_SSL=true
# Optional — not required by the app (it talks to Postgres directly via DATABASE_URL).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Roblox ────────────────────────────────────────────────────────────────────
# Public game data needs NO key. An Open Cloud key is only useful for analytics
# of experiences you own; it is reserved for that future integration.
ROBLOX_API_KEY=
# Name search through roblox.com's undocumented omni-search endpoint (true/false)
ROBLOX_ENABLE_OMNI_SEARCH=true
# Outgoing request budget to Roblox (requests/second) and timeout
ROBLOX_MAX_RPS=4
ROBLOX_TIMEOUT_MS=8000

# ── Exchange rates ─────────────────────────────────────────────────────────────
# Optional ExchangeRate-API v6 key. Without it, Frankfurter (ECB) and
# open.er-api.com are used (no key needed).
EXCHANGE_RATE_API_KEY=

# ── Security ──────────────────────────────────────────────────────────────────
# Admin panel (/admin). Leave empty to disable the panel entirely.
ADMIN_PASSWORD=
# Random string ≥ 32 chars used to sign admin sessions: `openssl rand -hex 32`
ADMIN_SESSION_SECRET=
# Protects /api/cron/refresh. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=

# Public API rate limit per IP and CORS allow-list (comma-separated, * = any)
API_RATE_LIMIT_PER_MINUTE=120
CORS_ALLOWED_ORIGINS=*
