# ── Anthropic (obligatoria) ───────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Opcional: modelo a usar (por defecto claude-haiku-5-5)
# ANTHROPIC_MODEL=claude-haiku-5-5

# ── Sesión (obligatoria en producción) ────────────────────────────────────
# Firma la cookie que guarda el contador de uso. Genera una con:
#   openssl rand -hex 32
SESSION_SECRET=

# ── Stripe (si faltan, el pago funciona en modo simulado) ─────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# IDs de los precios recurrentes creados en Stripe (Productos → Añadir precio)
STRIPE_PRICE_MONTHLY=price_...   # 0,50 € / mes
STRIPE_PRICE_YEARLY=price_...    # 4,99 € / año (opcional)

# ── App ───────────────────────────────────────────────────────────────────
# URL pública, usada para las redirecciones de Stripe
APP_URL=http://localhost:3000
# Auditorías al mes por plan (0 = ilimitadas)
FREE_MONTHLY_LIMIT=2
PRO_MONTHLY_LIMIT=15

# ── Desarrollo ────────────────────────────────────────────────────────────
# 1 = devuelve un análisis de ejemplo sin llamar a Claude (para probar la UI)
# AUDITORX_MOCK=1
