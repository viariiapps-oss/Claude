# ── 1. Imprescindibles ────────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Firma cookies y sesiones. Genera una con: openssl rand -hex 32
SESSION_SECRET=

# ── 2. Base de datos (cuentas, compras y correos de interesados) ──────────
# En Vercel: Storage → Create → Upstash for Redis. Estas dos variables se
# añaden solas al conectar la base de datos al proyecto.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── 3. Inicio de sesión: activa los que quieras ───────────────────────────
# Cada botón aparece solo si sus variables están puestas.
# URL de retorno de cada proveedor: https://TU-DOMINIO/api/auth/callback/<google|github|apple>
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
# Correo (enlace mágico) con https://resend.com — requiere un dominio propio verificado
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM="AuditorX <hola@tu-dominio.com>"

# ── 4. Pagos ──────────────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys — los precios salen de src/lib/plans.ts,
# no hay que crear productos en Stripe.
STRIPE_SECRET_KEY=sk_test_...
# Opcional pero recomendado: Developers → Webhooks → https://TU-DOMINIO/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# ── 5. Varios ─────────────────────────────────────────────────────────────
# URL pública (redirecciones de Stripe)
APP_URL=http://localhost:3000
# Clave para consultar /api/admin/leads (mínimo 16 caracteres)
ADMIN_SECRET=
# ANTHROPIC_MODEL=claude-haiku-5-5

# ── Desarrollo ────────────────────────────────────────────────────────────
# 1 = análisis de ejemplo, login con cualquier correo y pagos simulados
# AUDITORX_MOCK=1
